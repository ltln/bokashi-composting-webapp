# Copy to /opt/bokashi/.env on the server, fill in, then `chmod 600 .env`.
# Never commit the real file.

# --- Public URL ---------------------------------------------------------------
# Public HTTPS origin served through Cloudflare Tunnel (no trailing slash).
APP_ORIGIN=https://bokashi.example.com
# Must match an "Authorized redirect URI" in Google Cloud: <APP_ORIGIN>/api/auth/google/callback
OAUTH_REDIRECT_URL=https://bokashi.example.com/api/auth/google/callback

# --- Google OAuth -------------------------------------------------------------
# How to create these: docs/setup/google-oauth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Secrets ------------------------------------------------------------------
# Generate each one separately with: openssl rand -base64 32
SESSION_SECRET=
USER_HASH_SECRET=

# --- Postgres (used by the db container and to build the api DATABASE_URL) ----
# Use a URL-safe password (e.g. `openssl rand -hex 24`); it goes into a URL.
POSTGRES_USER=bokashi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bokashi

# --- Misc ---------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Image tags (leave unset; deploy.sh sets these during a rollback) ----------
# API_TAG=latest
# WEB_TAG=latest
