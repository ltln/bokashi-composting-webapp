# Copy to .env and fill in. The Makefile loads .env automatically.

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://bokashi:bokashi@localhost:5432/bokashi?sslmode=disable

# Google OAuth (M1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Secrets: generate each with `openssl rand -base64 32`
SESSION_SECRET=
USER_HASH_SECRET=

# Public origin of the web app (redirects and the Origin check on POST)
APP_ORIGIN=http://localhost:3000

# Go API listen port, and where the Next.js /api proxy forwards to
PORT=8080
API_INTERNAL_URL=http://localhost:8080
